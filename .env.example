# =============================================================================
# FPSO EPC Project Control System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables use the FPSO_ prefix (see backend/config.py).
# =============================================================================

# --- Required Secrets ---
# Database connection string (asyncpg driver)
FPSO_DATABASE_URL=postgresql+asyncpg://fpso_user:secure_pass@localhost:5432/fpso_db

# JWT signing key — use a strong random string in production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FPSO_SECRET_KEY=change-me-in-production

# --- Optional: Redis ---
FPSO_REDIS_URL=redis://localhost:6379

# --- Optional: API Key Authentication ---
# Set this to enable simple API key auth as a first line of defense.
# All requests must include header: X-API-Key: <this value>
# FPSO_API_KEY=your-secure-api-key

# --- Optional: CORS ---
# Comma-separated list of allowed origins (defaults to localhost dev ports)
# FPSO_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional: Alert Service ---
FPSO_ALERT_CHECK_INTERVAL_MINUTES=360

# --- Optional: AI / Claude Integration ---
# Get your API key at https://console.anthropic.com/
FPSO_ANTHROPIC_API_KEY=
FPSO_ANTHROPIC_MODEL=claude-sonnet-4-20250514
FPSO_AI_ENABLED=false
FPSO_AI_MAX_TOKENS=4096
FPSO_AI_TEMPERATURE=0.2
FPSO_AI_CACHE_ENABLED=true
FPSO_AI_BATCH_INTERVAL_MINUTES=30
FPSO_AI_MAX_CONCURRENT_AGENTS=3

# --- Optional: LangGraph ---
FPSO_LANGGRAPH_CHECKPOINTER=memory
FPSO_LANGGRAPH_MAX_STEPS=25

# --- Optional: Audit ---
FPSO_AI_AUDIT_LOG_ENABLED=true
FPSO_AI_RECOMMENDATION_LOG_RETENTION_DAYS=365
