# =============================================================================
# FPSO EPC Project Control System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All variables use the FPSO_ prefix (see backend/config.py).
# =============================================================================

# --- Environment ---
# development | test | production
# Production enables strict startup validation (fails closed), disables API
# docs, requires HSTS/CSP, and rejects mutating requests without Origin/Referer.
FPSO_ENVIRONMENT=development

# --- Required Secrets ---
# Database connection string (asyncpg driver)
FPSO_DATABASE_URL=postgresql+asyncpg://fpso_user:secure_pass@localhost:5432/fpso_db

# JWT signing key — use a strong random string in production (>= 32 chars)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
FPSO_SECRET_KEY=change-me-in-production

# --- Authentication ---
# Emergency kill switch ONLY. Leave true; false makes missing/invalid tokens
# resolve to a synthetic admin and must never be used in production.
FPSO_AUTH_ENFORCEMENT=true

# First-run admin bootstrap: created only when the users table is empty.
# Production refuses to start with no users and no bootstrap password.
FPSO_BOOTSTRAP_ADMIN_USERNAME=admin
FPSO_BOOTSTRAP_ADMIN_PASSWORD=

# Dev server (dev_main.py) seeded admin password — ignored in production.
FPSO_DEV_ADMIN_USERNAME=admin
FPSO_DEV_ADMIN_PASSWORD=dev-admin-password

# --- Logging ---
# json | text
FPSO_LOG_FORMAT=json

# --- Optional: Redis ---
FPSO_REDIS_URL=redis://localhost:6379

# --- Optional: API Key Authentication ---
# Set this to enable simple API key auth as a first line of defense.
# All requests must include header: X-API-Key: <this value>
# FPSO_API_KEY=your-secure-api-key

# --- Optional: CORS ---
# Comma-separated list of allowed origins (defaults to localhost dev ports).
# Wildcards are rejected in production.
# FPSO_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional: Trusted hosts (Host header allow-list) ---
# Set this to your real hostnames before deploying to production.
# FPSO_TRUSTED_HOSTS=localhost,127.0.0.1,fpso.example.com

# --- Optional: Alert Service ---
FPSO_ALERT_CHECK_INTERVAL_MINUTES=360

# --- Optional: AI / Claude Integration ---
# Get your API key at https://console.anthropic.com/
FPSO_ANTHROPIC_API_KEY=
FPSO_ANTHROPIC_MODEL=claude-sonnet-4-20250514
FPSO_AI_ENABLED=false
FPSO_AI_MAX_TOKENS=4096
FPSO_AI_TEMPERATURE=0.2
FPSO_AI_CACHE_ENABLED=true
FPSO_AI_BATCH_INTERVAL_MINUTES=30
FPSO_AI_MAX_CONCURRENT_AGENTS=3

# --- Optional: LangGraph ---
FPSO_LANGGRAPH_CHECKPOINTER=memory
FPSO_LANGGRAPH_MAX_STEPS=25

# --- Optional: Audit ---
FPSO_AI_AUDIT_LOG_ENABLED=true
FPSO_AI_RECOMMENDATION_LOG_RETENTION_DAYS=365
