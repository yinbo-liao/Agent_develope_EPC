# Copy this file to .env for local development.
# Production refuses placeholder secrets and requires SEED_DEMO_USERS=false.

ENVIRONMENT=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-change-me-in-production

# Database connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://aiwf:demo_password@localhost:5432/aiwf_dev

# Redis connection
REDIS_URL=redis://:demo_password@localhost:6379/0

# Open Policy Agent URL
OPA_URL=http://localhost:8181

# Demo identity (development only). Seeded on startup when SEED_DEMO_USERS=true.
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=demo-pass-1234
DEMO_REVIEWER_PASSWORD=reviewer-pass-1234
DEMO_ADMIN_PASSWORD=admin-pass-1234

# Durable execution worker (one per process; safe to run on every replica)
WORKER_ENABLED=true
JOB_MAX_ATTEMPTS=3

# Protect /metrics in deployed environments; empty hides it in production.
METRICS_TOKEN=

# Observability (optional in development)
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# MCP Server toggles
MCP_POSTGRES_ENABLED=true
MCP_GITHUB_ENABLED=false
MCP_PUPPETEER_ENABLED=false
MCP_SLACK_ENABLED=false